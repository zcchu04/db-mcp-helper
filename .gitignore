# 构建中间产物（jlink 运行时、打包输入、产物）
dist/
outputs/
*.bak-*
installer/inno-wrapper-generated.iss

# Maven 构建产物
**/target/
**/*.class
# maven-shade-plugin 自动生成的降级 pom
setup-app/dependency-reduced-pom.xml

# Tauri 桌面壳构建中间产物
shell/node_modules/
shell/src-tauri/target/
shell/bundle/
# 图标集：源图 + tauri icon 生成的平台图标全部入库（CI 需要它们来打包）

# 个人开发日志（不入库）
.workbuddy/

# 内嵌的大体积二进制资源（CI 会重新生成，本地按需生成）
setup-app/src/main/resources/toolkit/
setup-app/src/main/resources/tap/
setup-app/src/main/resources/runtime/

# IDE
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# 系统垃圾
.DS_Store
Thumbs.db
*.log

# 测试残留
*.tmp
tapdbg.txt
